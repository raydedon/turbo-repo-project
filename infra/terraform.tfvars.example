# Copy this to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored — never commit secrets.

aws_region  = "ap-southeast-2"
project     = "turbo-graphql"
environment = "production"
# AWS credentials are NOT set here. The provider reads them automatically from:
#   Local dev  — ~/.aws/credentials  (set up via `aws configure`)
#   CI/CD      — AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY environment variables
#                (store these as GitHub Actions secrets)

# Get these from your AWS VPC console or a VPC module output
vpc_id     = "vpc-0efada7652e40beb6"
subnet_ids = ["subnet-0f265e64bdfb9fb81", "subnet-0774467101198569e", "subnet-05e65717973969d81"]

# Which CIDR ranges can reach RDS (your ECS private subnets or VPN)
allowed_cidr_blocks = ["172.31.0.0/16"]

db_instance_class    = "db.t3.micro"
db_allocated_storage = 20

# ECS / deployment
image_tag     = "latest"   # overridden by CI/CD to git SHA
ecs_cpu       = 256        # 256 = 0.25 vCPU
ecs_memory    = 512        # MB
desired_count = 1

db_master_username = "postgres"
# db_master_password — set via environment variable to avoid storing in file:
#   export TF_VAR_db_master_password="your-strong-password"
